import has_datasheet
import has_designator_prefix
import has_part_picked
import is_atomic_part

component SN74HC74D_package:
    """SN74HC74D — Dual D-Type Positive-Edge-Triggered Flip-Flop with Clear and Preset,
    SOIC-14. LCSC C5765 (Texas Instruments SN74HC74DR).
    Datasheet-verified SOIC-14 pinout:
      pin 1 = 1CLR_N, pin 2 = 1D, pin 3 = 1CLK, pin 4 = 1PRE_N, pin 5 = 1Q, pin 6 = 1Q_N,
      pin 7 = GND, pin 8 = 2Q_N, pin 9 = 2Q, pin 10 = 2PRE_N, pin 11 = 2CLK,
      pin 12 = 2D, pin 13 = 2CLR_N, pin 14 = VCC.
    Use half as SR latch: D=VCC, CLK=Set (rising edge), CLR_N=Reset_N, Q=Output."""

    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="SN74HC74DR",
        footprint="SOIC-14_L8.7-W3.9-P1.27-LS6.0-BL.kicad_mod", symbol="SN74HC74D.kicad_sym",
        model="SOIC-14_L8.6-W3.9-H1.5-LS6.0-P1.27.step">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C5765",
        manufacturer="Texas Instruments", partno="SN74HC74DR">
    trait has_designator_prefix<prefix="U">
    trait has_datasheet<datasheet="https://www.lcsc.com/datasheet/lcsc_datasheet_1810131823_Texas-Instruments-SN74HC74DR_C5765.pdf">

    # pins — SOIC-14 dual D-FF
    pin 1
    pin 2
    pin 3
    pin 4
    pin 5
    pin 6
    pin 7
    pin 8
    pin 9
    pin 10
    pin 11
    pin 12
    pin 13
    pin 14

    # FF1 signals
    signal CLR1_N  ~ pin 1    # FF1 async clear (active low)
    signal D1      ~ pin 2    # FF1 data input
    signal CLK1    ~ pin 3    # FF1 clock
    signal PRE1_N  ~ pin 4    # FF1 async preset (active low)
    signal Q1      ~ pin 5    # FF1 Q output
    signal Q1_N    ~ pin 6    # FF1 Q-bar output

    # Power
    signal GND     ~ pin 7    # Ground
    signal VCC     ~ pin 14   # Supply

    # FF2 signals
    signal Q2_N    ~ pin 8    # FF2 Q-bar output
    signal Q2      ~ pin 9    # FF2 Q output
    signal PRE2_N  ~ pin 10   # FF2 async preset (active low)
    signal CLK2    ~ pin 11   # FF2 clock
    signal D2      ~ pin 12   # FF2 data input
    signal CLR2_N  ~ pin 13   # FF2 async clear (active low)
