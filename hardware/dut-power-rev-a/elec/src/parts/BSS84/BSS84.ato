import has_datasheet
import has_designator_prefix
import has_part_picked
import is_atomic_part

component BSS84_package:
    """BSS84 — P-Channel Small Signal MOSFET, -60V/-130mA, SOT-23.
    LCSC C38637 (Nexperia BSS84,215 or equivalent).
    Datasheet-verified SOT-23 pinout (KiCad SOT-23 = EIA SOT-23):
      pin 1 = Gate, pin 2 = Source, pin 3 = Drain."""

    trait is_atomic_part<manufacturer="Nexperia", partnumber="BSS84,215",
        footprint="SOT-23_L2.9-W1.3-P1.90-LS2.4-BR.kicad_mod", symbol="BSS84.kicad_sym",
        model="SOT-23_L2.9-W1.6-H1.1-LS2.4-P0.95.STEP">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C38637",
        manufacturer="Nexperia", partno="BSS84,215">
    trait has_designator_prefix<prefix="Q">
    trait has_datasheet<datasheet="https://www.lcsc.com/datasheet/lcsc_datasheet_2108171900_Nexperia-BSS84-215_C38637.pdf">

    # pins — SOT-23 P-ch MOSFET
    pin 1
    pin 2
    pin 3

    signal G ~ pin 1    # Gate
    signal S ~ pin 2    # Source
    signal D ~ pin 3    # Drain
