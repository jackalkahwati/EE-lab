    # pins — SOT-23-3 voltage reference
    pin 1
    pin 2
    pin 3

    signal OUT ~ pin 1   # Reference output (3.3 V)
    signal GND ~ pin 2   # Ground
    signal IN  ~ pin 3   # Input supply (up to 18 V)
