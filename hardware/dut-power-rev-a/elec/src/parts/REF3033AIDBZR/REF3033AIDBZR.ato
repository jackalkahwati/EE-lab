component REF3033AIDBZR_package:
    """REF3033AIDBZR — 3.3V 100mA Low-Dropout Precision Voltage Reference,
    0.2% initial accuracy, SOT-23-3. LCSC C2658776 (Texas Instruments REF3033AIDBZR).
    Datasheet-verified SOT-23-3 pinout:
      pin 1 = OUT, pin 2 = GND, pin 3 = IN."""

    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="REF3033AIDBZR", footprint="SOT-23-3_L2.9-W1.3-P1.90-LS2.4-BR.kicad_mod", symbol="REF3033AIDBZR.kicad_sym", model="SOT-23_L2.9-W1.6-H1.1-LS2.4-P0.95.STEP">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C2658776", manufacturer="Texas Instruments", partno="REF3033AIDBZR">
