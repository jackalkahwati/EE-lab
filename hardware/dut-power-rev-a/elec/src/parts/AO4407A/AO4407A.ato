import has_datasheet
import has_designator_prefix
import has_part_picked
import is_atomic_part

component AO4407A_package:
    """AO4407A — P-Channel Enhancement Mode MOSFET, -30V/-12A, SOP-8.
    LCSC C338 (Alpha & Omega Semiconductor AO4407A).
    Datasheet-verified SOP-8 pinout:
      pin 1 = Gate, pin 2 = Gate, pin 3 = Source, pin 4 = Source,
      pin 5 = Drain, pin 6 = Drain, pin 7 = Drain, pin 8 = Drain.
    Note: pins 1+2 tied (Gate bus); 3+4 tied (Source bus); 5+6+7+8 tied (Drain bus)."""

    trait is_atomic_part<manufacturer="Alpha & Omega Semiconductor", partnumber="AO4407A",
        footprint="SOP-8_L5.0-W4.0-P1.27-LS6.0-BL.kicad_mod", symbol="AO4407A.kicad_sym",
        model="SOP-8_L4.9-W3.9-H1.7-LS6.0-P1.27.STEP">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C338",
        manufacturer="Alpha & Omega Semiconductor", partno="AO4407A">
    trait has_designator_prefix<prefix="Q">
    trait has_datasheet<datasheet="https://www.lcsc.com/datasheet/lcsc_datasheet_2208231130_Alpha---Omega-Semicon-AO4407A_C338.pdf">

    # pins — SOP-8 P-ch MOSFET
    pin 1
    pin 2
    pin 3
    pin 4
    pin 5
    pin 6
    pin 7
    pin 8

    signal G ~ pin 1    # Gate (pin 1 + 2 shorted)
    signal G2 ~ pin 2   # Gate (tied to pin 1 externally)
    signal S ~ pin 3    # Source (pin 3 + 4 shorted)
    signal S2 ~ pin 4   # Source (tied to pin 3 externally)
    signal D ~ pin 5    # Drain (pins 5+6+7+8 shorted)
    signal D2 ~ pin 6
    signal D3 ~ pin 7
    signal D4 ~ pin 8
