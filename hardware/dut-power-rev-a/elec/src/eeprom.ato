"""
EepromModule — 24AA025UIDT-I/OT I2C EEPROM with pull-ups and decoupling.

Stores board identity, calibration constants, and fault log for this
DUT Power board. I2C address: 0x50 (A0=A1=GND).

Memory map:
  0x00–0x07  board type   "FL1-DPWR"
  0x08–0x0F  revision     "REV-A\0\0\0"
  0x10–0x17  serial no.   8-char ASCII
  0x18       board state  0xA5 = calibrated
  0x19       checksum     XOR of 0x00–0x18
  0x20–0x5F  cal data     16× float32 (per rail Vout_gain, Vout_offset,
                           I_gain, I_offset — 4 floats × 4 rails)
  0x60–0x7F  reserved
  0x80–0xF8  unique ID    factory-programmed (read-only, 64-bit MAC)
"""

import ElectricPower
import Resistor
import Capacitor
from "parts/Microchip_Tech_24AA025UIDT_I_OT/Microchip_Tech_24AA025UIDT_I_OT.ato" import Microchip_Tech_24AA025UIDT_I_OT_package


module EepromModule:
    vcc = new ElectricPower   # 3.3V supply
    signal sda
    signal scl

    eeprom = new Microchip_Tech_24AA025UIDT_I_OT_package

    # Address 0x50: A0=A1=GND
    eeprom.A0  ~ vcc.lv
    eeprom.A1  ~ vcc.lv
    eeprom.VCC ~ vcc.hv
    eeprom.VSS ~ vcc.lv
    eeprom.SDA ~ sda
    eeprom.SCL ~ scl

    # SDA/SCL pull-ups (4.7 kΩ; I2C standard-mode 100 kHz)
    r_sda = new Resistor
    r_sda.resistance = 4.7kohm +/- 5%
    r_scl = new Resistor
    r_scl.resistance = 4.7kohm +/- 5%
    vcc.hv ~ r_sda.unnamed[0]
    r_sda.unnamed[1] ~ sda
    vcc.hv ~ r_scl.unnamed[0]
    r_scl.unnamed[1] ~ scl

    # VCC decoupling
    c_vcc = new Capacitor
    c_vcc.capacitance = 100nF +/- 10%
    vcc.hv ~ c_vcc.unnamed[0]
    c_vcc.unnamed[1] ~ vcc.lv
