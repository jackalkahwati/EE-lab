{
  "board": "eload-rev-a",
  "board_type_eeprom": "FL1-ELOAD",
  "i2c_devices": {
    "0x40": "INA219 CH1 (A0=GND, A1=GND)",
    "0x41": "INA219 CH2 (A0=VS,  A1=GND)",
    "0x42": "INA219 CH3 (A0=SDA, A1=GND)",
    "0x43": "INA219 CH4 (A0=SCL, A1=GND)",
    "0x46": "INA219 coil rail monitor (A0=SDA, A1=GND in power.ato)",
    "0x50": "24AA025UIDT EEPROM (A0=A1=GND)",
    "0x60": "MCP4728 DAC-lo (ch A=CH1, ch B=CH2)",
    "0x61": "MCP4728 DAC-hi (ch A=CH3, ch B=CH4)"
  },
  "gpio_map": {
    "GP0": "WDI watchdog kick output (TPS3823 WDI pin)",
    "GP1": "nRESET from watchdog (TPS3823 nRESET, MCU input)",
    "GP2": "I2C0 SDA (shared bus: INA219 x4+coil + MCP4728 x2 + EEPROM)",
    "GP3": "I2C0 SCL",
    "GP4": "relay_ch1_in — input relay CH1 coil (active-high, 5V coil)",
    "GP5": "relay_ch1_dis — discharge relay CH1 coil",
    "GP6": "relay_ch2_in",
    "GP7": "relay_ch2_dis",
    "GP8": "relay_ch3_in",
    "GP9": "relay_ch3_dis",
    "GP10": "relay_ch4_in",
    "GP11": "relay_ch4_dis",
    "GP12": "LED_power (green indicator, always-on when 3.3V up)",
    "GP13": "LED_fault (red fault indicator)",
    "GP14": "LED_ch1 (yellow channel 1 active)",
    "GP15": "LED_ch2 (yellow channel 2 active)",
    "GP16": "LED_ch3 (yellow channel 3 active)",
    "GP17": "LED_ch4 (yellow channel 4 active)",
    "GP18": "LED_thermal (orange/red overtemp warning)",
    "GP19": "fan_pwm — 25kHz PWM to 2N7002 gate (fan speed control)",
    "GP20": "fan_tach — tachometer pulse input from fan",
    "GP26": "ADC0 — thermistor CH1 NTC midpoint voltage",
    "GP27": "ADC1 — thermistor CH2 NTC midpoint voltage",
    "GP28": "ADC2 — thermistor CH3 NTC midpoint voltage",
    "GP29": "ADC3 — thermistor CH4 NTC midpoint voltage"
  },
  "commands": [
    "SET LOAD<1-4> <mA>",
    "SET RESIST<1-4> <ohm>",
    "SET POWER<1-4> <mW>",
    "SET FAN <pct>",
    "ENABLE LOAD<1-4>",
    "ENABLE ALL",
    "DISABLE LOAD<1-4>",
    "DISABLE ALL",
    "START PULSE <ch> <duty%> <freq_hz> <high_mA>",
    "START TRANSIENT <ch> <low_mA> <high_mA>",
    "RUN DISCHARGE <ch>",
    "RUN SELFTEST",
    "READ TELEMETRY",
    "READ FAULTS",
    "CAPTURE <ch>",
    "STATUS"
  ],
  "channel_count": 4,
  "max_current_ma": 3000,
  "max_voltage": 24,
  "pulse_max_current_ma": 5000,
  "pulse_max_duration_ms": 100,
  "sense_resistor_mohm": 100,
  "ina219_config": {
    "config_reg": "0x3FFF",
    "description": "32V bus range, gain/8 (320mV shunt range), 12-bit 128-sample averaging, continuous mode",
    "calib_reg": 4096,
    "current_lsb_ua": 10,
    "power_lsb_uw": 200
  },
  "dac_full_scale_v": 3.3,
  "dac_bits": 12,
  "dac_current_mapping": "0V = 0mA, 3.3V = 3000mA (linear)",
  "ntc_beta": 3950,
  "ntc_r25_ohm": 10000,
  "ntc_bias_ohm": 10000,
  "thermal_shutdown_c": 85,
  "fan_pwm_hz": 25000,
  "fan_control": "proportional: pct = (T_max - 60) * 5, auto unless SET FAN overrides",
  "watchdog_kick_period_ms": 100,
  "watchdog_timeout_ms": 1600,
  "relay_coil_voltage": 5,
  "sense_amp_gain": 11,
  "op_amp_supply": "3.3V single-supply (MCP6002, R-R I/O)"
}
