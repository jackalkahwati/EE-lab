import has_datasheet
import has_designator_prefix
import has_part_picked
import is_atomic_part

component Viking_Tech_ARG03BTC100R_package:
    """Viking Tech ARG03BTC100R — 10 Ω 0.01% 0603 thin-film precision resistor.
    LCSC binding: run `ato create part -s ARG03BTC10R0 -a` to confirm current
    LCSC part number at order time. If unavailable, substitute Susumu
    RG1608P-100-D-T10 (10 Ω 0.5%) or Vishay TNPW0603100RF (1%) noting the
    looser tolerance in the cal EEPROM calibration constant page."""

    trait is_atomic_part<manufacturer="Viking Tech", partnumber="ARG03BTC100R",
        footprint="R0603.kicad_mod", symbol="ARG03BTC100R.kicad_sym", model="R0603.STEP">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C335080",
        manufacturer="Viking Tech", partno="ARG03BTC100R">
    trait has_designator_prefix<prefix="R">
    trait has_datasheet<datasheet="https://www.viking.com.tw/images/Products/ARG/ARG-e.pdf">

    pin 1
    pin 2
    signal p1 ~ pin 1
    signal p2 ~ pin 2
