{
  "name": "prompt-to-pcb-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:enterprise": "for test in scripts/test_e*.mjs; do node \"$test\" || exit 1; done",
    "test": "pnpm test:unit && pnpm test:enterprise",
    "sync-board": "bash scripts/sync-board.sh",
    "last-run": "node scripts/show-last-run.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "netlistsvg": "^1.0.2",
    "next": "16.2.6",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "elkjs": "0.9.3",
      "hono": "4.12.29",
      "json5@<1.0.2": "1.0.2",
      "postcss": "8.5.16",
      "yargs-parser@<=5.0.0": "5.0.1"
    }
  }
}
