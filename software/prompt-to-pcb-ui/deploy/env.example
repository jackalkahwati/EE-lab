# Copy to /etc/firstlight-compose.env on the VM, fill in real values, chmod 600.
#   sudo cp deploy/env.example /etc/firstlight-compose.env
#   sudo chmod 600 /etc/firstlight-compose.env && sudo chown root:root /etc/firstlight-compose.env
# NEVER commit the filled-in file. The systemd unit loads this via EnvironmentFile.

NODE_ENV=production

# --- critical: without AUTH_SECRET, production login is disabled ---
# generate with: openssl rand -base64 48
AUTH_SECRET=

# public origin — builds the Google OAuth redirect URI and Stripe redirects
APP_URL=https://app.firstlight.build

# --- edge rate limiting (proxy.ts) — protects shared LLM keys / credits at launch ---
# In-memory sliding window, single-instance. Keyed by signed-in user id on the
# pipeline route (else client IP), by IP on the auth routes. On limit: HTTP 429
# with Retry-After. Only /api/pipeline/run and /api/auth/{login,signup,google}
# are limited; all other routes and static assets are untouched.
# Leave unset to use the defaults shown. Set a tier to 0 to disable just that tier.
FL_RATELIMIT_DISABLED=          # set to 1 to bypass ALL rate limiting (escape hatch)
FL_RL_PIPELINE_PER_MIN=5        # /api/pipeline/run burst cap per user/IP per minute
FL_RL_PIPELINE_PER_HOUR=60      # /api/pipeline/run sustained cap per user/IP per hour
FL_RL_AUTH_PER_MIN=10           # /api/auth/* attempts per IP per minute (stops signup farming)
FL_RL_AUTH_PER_HOUR=60          # /api/auth/* attempts per IP per hour
FL_RL_CONTACT_PER_MIN=5         # /api/contact submissions per IP per minute
FL_RL_MAX_KEYS=10000            # cap on tracked limiter keys (LRU-evicted); bounds memory under IP rotation
# Client IP for the limiter is cf-connecting-ip, else the LAST x-forwarded-for
# hop (the one your proxy appended), else x-real-ip. Make sure the reverse proxy
# in front of the app sets one of these.

# enterprise store on the persistent disk (under the app dir, survives redeploys)
ENTERPRISE_STORE_DIR=/home/ubuntu/EE-lab/software/prompt-to-pcb-ui/data/enterprise

# --- Google OAuth (whitelist https://app.firstlight.build/api/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---
# For a REAL launch that takes money: use the LIVE secret key (sk_live_…) and set
# STRIPE_WEBHOOK_SECRET (from the Stripe dashboard webhook signing secret) — the
# billing webhook returns 503 until STRIPE_WEBHOOK_SECRET is set, so async
# payment + cancellation events are dropped without it. A restricted test key
# (rk_test_) only exercises the checkout-redirect fallback.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- LAUNCH-CRITICAL: platform-funded model -------------------------------------
# Without this, a signed-up user with NO API key of their own cannot generate
# (the run route 402s and the resolver has no model). Set OPENROUTER_API_KEY to a
# funded OpenRouter key and free/Pro/Enterprise all run on it (billed via each
# model's creditMult); BYOK and admin paths are unaffected. Verify the OR_* slugs
# against openrouter.ai/models once the account is funded.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OR_SONNET_MODEL=
OR_OPUS_MODEL=
OR_GPT_MODEL=
OR_GEMINI_MODEL=

# --- run concurrency (multi-tenant caps for the single-instance deployment) -----
# Total simultaneous pipeline runs across all users, and the per-account cap.
FL_MAX_CONCURRENT_RUNS=3
FL_MAX_RUNS_PER_USER=1

# --- model providers (copy from your local .env.local) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=

# --- parts sourcing / fab quotes (copy from local .env.local) ---
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_BASE=
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
JLCPCB_APP_ID=
JLCPCB_ACCESS_KEY=
JLCPCB_SECRET_KEY=
MACROFAB_API_KEY=
PCBWAY_API_KEY=

# --- operational variables (documented in deploy/OPS.md) -----------------------
# AUTH_SECRET (above) is the signing secret for sessions and BYOK key encryption.
# FL_PASSWORD is a DEPRECATED alias for AUTH_SECRET (lib/auth.ts, proxy.ts fall
# back to it). Set AUTH_SECRET only; do not set both.

# Python interpreter for every planner / simulation subprocess (default: python3).
# Must have jsonschema, easyeda2kicad, and the sim solver bindings installed.
FL_PYTHON=

# Comma-separated admin accounts. Gates admin routes; the first entry is also the
# default CONTACT_NOTIFY_EMAIL for /api/contact leads.
FL_ADMIN_EMAILS=

# Public origin used to build absolute statusUrl / artifactsUrl in the v1 API.
# Set when the app sits behind a tunnel or reverse proxy whose request origin is
# not the public host (e.g. https://app.firstlight.build).
FL_SELF_URL=

# KiCad toolchain (lib/toolchain.ts). kicad-cli for DRC/exports/renders and the
# python bundled with KiCad. Unset falls back to PATH / homebrew guesses.
FL_KICAD_CLI=
FL_KICAD_PYTHON=

# In-product admin Shell tab. Leave UNSET in production (never set in the compose
# launchd plist); FL_TERMINAL=1 gives admins a shell on the serving machine.
# Intentionally commented out so a copied env file cannot enable it by accident.
# FL_TERMINAL=1

# Backups (deploy/backup-data.sh). FL_BACKUP_DIR is the local snapshot dir
# (default ~/firstlight-backups); FL_BACKUP_REMOTE is an rsync target for an
# off-machine mirror — set it, the default keeps backups on the live drive.
FL_BACKUP_DIR=
FL_BACKUP_REMOTE=

# --- Onshape (enclosure CAD + STEP export) --------------------------------------
# WITHOUT THESE THE MECHANICAL STAGE CANNOT PRODUCE CAD. The route spawns
# tools/onshape/render_plan.py, which builds the enclosure in a real Onshape
# document and exports STEP/glTF/renders. It reads these from the environment
# first, then falls back to tools/onshape/.env (gitignored) — so set them in
# BOTH places if you want the script to work when run by hand too.
# Source: the work-hub vault (sops+age).
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# Optional; defaults to https://cad.onshape.com
ONSHAPE_BASE_URL=
