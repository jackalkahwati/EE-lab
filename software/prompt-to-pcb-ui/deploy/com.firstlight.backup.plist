<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.firstlight.backup — periodic FirstLight Compose data backup.

  Runs deploy/backup-data.sh every 6 hours (and once at load) to snapshot
  data/ and public/runs/ into ~/firstlight-backups (rotated, last 14 kept).

  INSTALL (do NOT run as root; agents are per-GUI-session):
    cp "/Volumes/T9 Backup/EE-lab/software/prompt-to-pcb-ui/deploy/com.firstlight.backup.plist" \
       "$HOME/Library/LaunchAgents/com.firstlight.backup.plist"
    launchctl bootstrap gui/$(id -u) "$HOME/Library/LaunchAgents/com.firstlight.backup.plist"

  To set an off-machine mirror, add an FL_BACKUP_REMOTE entry to the
  EnvironmentVariables dict below (rsync/scp destination), then re-bootstrap.

  VERIFY:  launchctl list | grep com.firstlight.backup
  LOGS:    /tmp/firstlight-backup.log  /tmp/firstlight-backup.err
  UNLOAD:  launchctl bootout gui/$(id -u)/com.firstlight.backup
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.firstlight.backup</string>

  <!-- Launched THROUGH node, not /bin/bash directly: macOS privacy protection
       (TCC) denies a launchd-spawned /bin/bash access to removable volumes
       ("Operation not permitted" on /Volumes/T9 Backup), while node, which
       already serves the app from that volume under launchd, is permitted.
       The responsible process for TCC is the job's own executable, so a bash
       child of node inherits node's access. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>-e</string>
    <string>process.exit(require('child_process').spawnSync('/bin/bash',[process.env.HOME+'/bin/firstlight-backup.sh'],{stdio:'inherit'}).status??1)</string>
  </array>

  <!-- Off the monitored drive: if the T9 volume is missing launchd must still be
       able to start this job (a WorkingDirectory on the drive would prevent that). -->
  <key>WorkingDirectory</key>
  <string>/Users/jackal-kahwati</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- The script is installed at ~/bin, so tell it where the app lives. -->
    <key>FL_APP_DIR</key><string>/Volumes/T9 Backup/EE-lab/software/prompt-to-pcb-ui</string>
    <!-- Internal disk: off the USB drive the live data sits on. -->
    <key>FL_BACKUP_DIR</key><string>/Users/jackal-kahwati/firstlight-backups</string>
    <key>FL_BACKUP_KEEP</key><string>14</string>
    <!-- LOCAL snapshots stay limited to the 52 MB account/enterprise store:
         this Mac's boot volume has only a few GB free and the run store is
         4.6 GB. The run store still leaves the machine — FL_BACKUP_S3 below
         syncs the LIVE sources to S3, which needs no local disk. -->
    <key>FL_BACKUP_SOURCES</key><string>data</string>
    <!-- Off-machine copy of EVERYTHING (data + public/runs). The bucket is
         private, encrypted and versioned, so overwritten/deleted objects are
         retained for 90 days as previous versions. -->
    <key>FL_BACKUP_S3</key><string>s3://firstlight-backups-120987622881/compose</string>
    <!-- aws lives in /opt/homebrew/bin, already on PATH above. HOME is needed
         so the CLI finds ~/.aws/credentials under launchd. -->
    <key>HOME</key><string>/Users/jackal-kahwati</string>
    <!-- Optional: uncomment and set an off-MACHINE target for real durability.
    <key>FL_BACKUP_REMOTE</key><string>user@host:/path/firstlight-backups</string>
    -->
  </dict>

  <!-- Every 6 hours (21600 s). Also runs immediately at load. -->
  <key>StartInterval</key><integer>21600</integer>
  <key>RunAtLoad</key><true/>

  <key>StandardOutPath</key><string>/tmp/firstlight-backup.log</string>
  <key>StandardErrorPath</key><string>/tmp/firstlight-backup.err</string>
</dict></plist>
