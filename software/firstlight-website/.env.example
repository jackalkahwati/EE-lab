# Public origin of this website. Required in production for safe Stripe redirects.
APP_URL=http://localhost:4400

# Public origin of the Compose application (production: https://app.firstlight.build).
NEXT_PUBLIC_COMPOSE_URL=http://localhost:4500

# Public origin of this website as seen by crawlers. Used by app/robots.ts and
# app/sitemap.ts; defaults to https://firstlight.build when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:4400

# Stripe credentials for the refundable FL-1 reservation deposit.
STRIPE_SECRET_KEY=
STRIPE_RESERVATION_PRICE=

# Optional hostname when Stripe Checkout uses a configured custom domain.
STRIPE_CHECKOUT_HOST=
