# Public origin of this website. Required in production for safe Stripe redirects.
APP_URL=http://localhost:4400

# Build-time public origins. HTTPS required in production; loopback is allowed
# only with next dev. Keep Compose origin aligned with its OAuth APP_URL.
NEXT_PUBLIC_COMPOSE_URL=https://app.firstlight.build
NEXT_PUBLIC_SITE_URL=https://firstlight.build

# Stripe key stays server-side. Do not switch payment mode during deployment.
STRIPE_SECRET_KEY=
# USD cents, shared with displayed price and Terms. No Stripe price ID is used.
STRIPE_RESERVATION_AMOUNT_CENTS=250000

# Optional hostname when Stripe Checkout uses a configured custom domain.
STRIPE_CHECKOUT_HOST=
